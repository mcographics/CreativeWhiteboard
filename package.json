{
  "name": "creative-whiteboard",
  "private": true,
  "version": "0.1.0",
  "description": "Creative Whiteboard is an infinite creative desktop whiteboard designed for drawing, annotation, document review, brainstorming, visual planning, and project organization.",
  "desktopName": "com.creativewhiteboard.app",
  "homepage": "https://creativewhiteboard.app",
  "author": {
    "name": "Majestic Creations"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "metadata": "node scripts/sync-app-info.cjs",
    "notices": "node scripts/generate-third-party-notices.cjs",
    "security:audit": "npm audit --audit-level=high",
    "dev": "node electron/dev.cjs",
    "dev:web": "vite",
    "build": "npm run metadata && npm run notices && tsc -b && vite build && npm run verify:dist",
    "verify:dist": "node scripts/verify-dist-assets.cjs",
    "generate:icon": "node -e \"import('png-to-ico').then(async ({default:pngToIco})=>{const fs=await import('node:fs/promises');await fs.writeFile('app_icon.ico',await pngToIco('app_icon.png'));})\"",
    "build:desktop": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux deb rpm AppImage",
    "build:linux:deb": "npm run build && electron-builder --linux deb",
    "build:linux:rpm": "npm run build && electron-builder --linux rpm",
    "pack:desktop": "npm run build && electron-builder --dir",
    "pack:linux": "npm run build && electron-builder --linux dir",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "font-list": "^2.1.0",
    "jspdf": "^4.2.1",
    "konva": "^9.3.22",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tauri-apps/cli": "^2.2.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "png-to-ico": "^3.0.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.creativewhiteboard.app",
    "productName": "Creative Whiteboard",
    "executableName": "CreativeWhiteboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "app-info.json",
      "app_icon.png",
      "LICENSE",
      "PRIVACY.md",
      "SECURITY.md",
      "THIRD-PARTY-NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app_icon.png",
        "to": "app_icon.png"
      }
    ],
    "win": {
      "icon": "app_icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "CreativeWhiteboard_Setup_${version}_${arch}.${ext}",
      "legalTrademarks": "Third-party product names and file formats belong to their respective owners."
    },
    "linux": {
      "icon": "app_icon.png",
      "category": "Graphics",
      "maintainer": "Majestic Creations",
      "vendor": "Majestic Creations",
      "synopsis": "Infinite creative desktop whiteboard",
      "description": "An offline-first infinite whiteboard for drawing, annotation, document review, brainstorming, visual planning, and project organization.",
      "executableName": "creative-whiteboard",
      "syncDesktopName": true,
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "artifactName": "CreativeWhiteboard_${version}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "app_icon.ico",
      "uninstallerIcon": "app_icon.ico",
      "shortcutName": "Creative Whiteboard"
    },
    "copyright": "Copyright © 2026 Majestic Creations. All rights reserved."
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "esbuild": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "license": "UNLICENSED"
}
